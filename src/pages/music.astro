---
import Artwork from "@/components/Artwork.astro";
import { getTopArtists, getTopTracks } from "@/lib/koito";
import Layout from "../layouts/Layout.astro";

const topArtists = await getTopArtists(10, "week").catch(() => []);
const topTracks = await getTopTracks(10, "week").catch(() => []);
---

<Layout title="Music — Niels Bik" description="My top artists and tracks." canonical="https://nielsbik.com/music">
    <header>
        <h1 class="font-serif text-2xl font-bold">Music</h1>
        <p class="text-secondary">My top artists and tracks.</p>
    </header>
    <main>
        <div class="prose wysiwyg-ol:ps-0 wysiwyg-li:ps-0">
            <h2 class="mb-5 mt-12 font-serif">Top artists</h2>
            <ol>
                {topArtists.map(({ image, name }, i) => (
                <li class="flex items-center gap-3">
                    <span class="w-7 shrink-0 text-right font-serif">{i + 1}.</span>
                    <Artwork src={image} alt={`Photo of ${name}`} rounded />
                    <span class="font-serif font-medium">{name}</span>
                </li>
                ))}
            </ol>
            <h2 class="mb-5 mt-12 font-serif">Top tracks</h2>
            <ol>
                {topTracks.map(({ album, artists, track }, i) => (
                <li class="flex items-center gap-3">
                    <span class="w-7 shrink-0 text-right font-serif">{i + 1}.</span>
                    <Artwork src={album.image} alt={`Cover for ${track.name}`} />
                    <div>
                        <span class="font-serif font-medium">{track.name}</span>
                        <div class="text-sm text-secondary">
                            {artists.at(0)?.name}
                        </div>
                    </div>
                </li>
                ))}
            </ol>
        </div>
    </main>
</Layout>
