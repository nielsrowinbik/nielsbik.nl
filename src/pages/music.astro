---
import ExternalLink from "@/components/ExternalLink.astro";
import { getTopArtists, getTopTracks } from "@/lib/lastfm";
import Layout from "../layouts/Layout.astro";

const topArtists = await getTopArtists(10, "7day").catch(() => []);
const topTracks = await getTopTracks(10, "7day").catch(() => []);
---

<Layout title="Music — Niels Bik" description="My top artists and tracks." canonical="https://nielsbik.com/music">
    <header>
        <h1 class="font-serif text-2xl font-bold">Music</h1>
        <p class="text-secondary">My top artists and tracks.</p>
    </header>
    <main>
        <div class="prose">
            <h2 class="mb-5 mt-12 font-serif">Top artists</h2>
            <ol>
                {topArtists.map(({ image, name, url }, i) => (
                <li class="flex items-center">
                    <span>{i + 1}</span>
                    <img alt={`Profile picture for ${name}`} class="size-8 rounded-md shrink-0 mb-0 mt-0" src={image} />
                    <ExternalLink class="font-serif font-medium hover:underline" href={url}>
                        {name}
                    </ExternalLink>
                </li>
                ))}
            </ol>
            <h2 class="mb-5 mt-12 font-serif">Top tracks</h2>
            <ol>
                {topTracks.map(({ album, artists, track }, i) => (
                <li class="flex items-center">
                    <span>{i + 1}</span>
                    <img alt={`Cover for ${album.name} by ${artists.at(0)?.name}`} class="size-8 rounded-md shrink-0 mb-0 mt-0" src={album.image} />
                    <div>
                        <ExternalLink class="font-serif font-medium hover:underline" href={track.url}>
                            {track.name}
                        </ExternalLink>
                        <div class="text-sm text-secondary">
                            {artists.at(0)?.name}
                        </div>
                    </div>
                </li>
                ))}
            </ol>
        </div>
    </main>
</Layout>
