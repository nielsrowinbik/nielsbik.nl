---
export const prerender = false;

import { getCollection } from "astro:content";
import ExternalLink from "@/components/ExternalLink.astro";
import LastFmLastListened from "@/components/LastFmLastListened.astro";
import MediaCard from "@/components/MediaCard.astro";
import { projects } from "@/data/projects";
import Layout from "@/layouts/Layout.astro";
import { getRecentlyPlayed } from "@/lib/lastfm";

const [recentTrack] = await getRecentlyPlayed(1).catch(() => []);

const writing = (await getCollection("writing")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=300, stale-while-revalidate=600",
);
---

<Layout title="Niels Bik" description="Senior Product Manager based in Sweden." canonical="https://nielsbik.com/">
    <header>
        <h1 class="font-serif font-bold text-2xl">Niels Bik</h1>
    </header>
    <main>
        <div class="prose">
            <p>
                I'm a Senior Product Manager at <ExternalLink href="https://www.openhomefoundation.org">Open Home Foundation</ExternalLink> working on making automations and AI Home Assistant more approachable.
            </p>
            <p>
                Previously, I worked at{" "}
                <ExternalLink
                    href="https://www.stuvia.com">Stuvia</ExternalLink
                > to make buying and selling study materials easy and fast, and at{" "}
                <ExternalLink
                    href="https://www.prorail.nl">ProRail</ExternalLink
                > to transform how the Dutch railroad sector creates the timetable.
            </p>
            <p>
                I'm a very curious and result-driven person. I like learning
                about how things work and why. I'm also a huge{" "}
                <a href="/music">music fan</a>.{" "}
                {recentTrack && <LastFmLastListened {...recentTrack} />}
            </p>
            <p>
                You can reach me on <ExternalLink
                    href="https://www.linkedin.com/in/nielsbik">LinkedIn</ExternalLink
                > or by{" "}
                <a class="" href="mailto:hey@nielsbik.nl">email</a>.
            </p>
        </div>

        <section class="mt-12">
            <h2 class="mb-5 font-serif font-bold text-lg">Projects</h2>
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
                {
                    projects.map((project) => (
                        <MediaCard
                            external
                            href={project.href}
                            image={project.image}
                            subtitle={project.subtitle}
                            title={project.title}
                            video={project.video}
                        />
                    ))
                }
            </div>
        </section>

        <section class="mt-12">
            <h2 class="mb-5 font-serif font-bold text-lg">Writing</h2>
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
                {
                    writing.map((entry) => (
                        <MediaCard
                            href={`/${entry.id}`}
                            subtitle={entry.data.subtitle}
                            title={entry.data.title}
                            transitionKey={entry.id.replace(/[^\w-]/g, "-")}
                        />
                    ))
                }
            </div>
        </section>
    </main>
</Layout>
